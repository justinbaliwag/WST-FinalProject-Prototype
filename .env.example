# Copy this file to ".env" only if you want live data.
# Leave it out completely and the app runs on built-in sample posts.

# Where posts come from: sample (default) or live
DATA_SOURCE=sample

# Only needed when DATA_SOURCE=live
# APIFY_TOKEN=your_token_here

# Optional: change the port (default 3000)
# PORT=3000

# Optional: force the "HTTPS only" cookie flag. It already turns on by itself
# when the site is served over HTTPS. Set this only if a proxy in front of the
# site hides that fact from the server.
# COOKIE_SECURE=true

# Optional: "Continue with Google" only turns on when both are set.
# Setup steps: docs/GOOGLE-SIGN-IN.md
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
